<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    package="com.stoneos.settings"
    android:sharedUserId="android.uid.system">

    <!-- System-level permissions needed for controlling settings -->
    <uses-permission android:name="android.permission.WRITE_SETTINGS" />
    <uses-permission android:name="android.permission.ACCESS_WIFI_STATE" />
    <uses-permission android:name="android.permission.CHANGE_WIFI_STATE" />
    <uses-permission android:name="android.permission.BLUETOOTH" />
    <uses-permission android:name="android.permission.BLUETOOTH_ADMIN" />
    <uses-permission android:name="android.permission.BLUETOOTH_CONNECT" />
    <uses-permission android:name="android.permission.WRITE_SECURE_SETTINGS" />

    <application
        android:label="@string/app_name"
        android:icon="@android:drawable/ic_menu_preferences"
        android:allowBackup="false">

        <!-- Main Settings Activity -->
        <activity
            android:name=".SettingsActivity"
            android:label="@string/app_name"
            android:exported="true"
            android:launchMode="singleTop">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
            <intent-filter>
                <action android:name="android.settings.SETTINGS" />
                <category android:name="android.intent.category.DEFAULT" />
            </intent-filter>
        </activity>

        <!-- Display Settings Activity -->
        <activity
            android:name=".DisplaySettingsActivity"
            android:label="@string/display_settings"
            android:exported="false"
            android:parentActivityName=".SettingsActivity" />

        <!-- Network Settings Activity -->
        <activity
            android:name=".NetworkSettingsActivity"
            android:label="@string/network_settings"
            android:exported="false"
            android:parentActivityName=".SettingsActivity" />

        <!-- BroadcastReceiver for Agent Control API -->
        <receiver
            android:name=".SettingsControlReceiver"
            android:exported="true"
            android:permission="android.permission.BROADCAST_SETTINGS">
            <intent-filter>
                <action android:name="com.stoneos.settings.SET_WIFI_STATE" />
                <action android:name="com.stoneos.settings.SET_BLUETOOTH_STATE" />
                <action android:name="com.stoneos.settings.SET_BRIGHTNESS" />
            </intent-filter>
        </receiver>

    </application>

</manifest>
