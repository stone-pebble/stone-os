<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#000000"
    android:fillViewport="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="24dp">

        <!-- Network & internet -->
        <TextView
            android:id="@+id/category_network"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/network_settings"
            android:textColor="#FFFFFF"
            android:textSize="20sp"
            android:paddingVertical="16dp"
            android:clickable="true"
            android:focusable="true"
            android:background="?android:attr/selectableItemBackground" />

        <!-- Connected devices -->
        <TextView
            android:id="@+id/category_connected_devices"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/connected_devices"
            android:textColor="#FFFFFF"
            android:textSize="20sp"
            android:paddingVertical="16dp"
            android:clickable="true"
            android:focusable="true"
            android:background="?android:attr/selectableItemBackground" />

        <!-- Display -->
        <TextView
            android:id="@+id/category_display"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/display_settings"
            android:textColor="#FFFFFF"
            android:textSize="20sp"
            android:paddingVertical="16dp"
            android:clickable="true"
            android:focusable="true"
            android:background="?android:attr/selectableItemBackground" />

        <!-- Sound & vibration -->
        <TextView
            android:id="@+id/category_sound"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/sound_settings"
            android:textColor="#FFFFFF"
            android:textSize="20sp"
            android:paddingVertical="16dp"
            android:clickable="true"
            android:focusable="true"
            android:background="?android:attr/selectableItemBackground" />

        <!-- Storage -->
        <TextView
            android:id="@+id/category_storage"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/storage_settings"
            android:textColor="#FFFFFF"
            android:textSize="20sp"
            android:paddingVertical="16dp"
            android:clickable="true"
            android:focusable="true"
            android:background="?android:attr/selectableItemBackground" />

        <!-- Security & privacy -->
        <TextView
            android:id="@+id/category_security"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/security_settings"
            android:textColor="#FFFFFF"
            android:textSize="20sp"
            android:paddingVertical="16dp"
            android:clickable="true"
            android:focusable="true"
            android:background="?android:attr/selectableItemBackground" />

        <!-- System -->
        <TextView
            android:id="@+id/category_system"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/system_settings"
            android:textColor="#FFFFFF"
            android:textSize="20sp"
            android:paddingVertical="16dp"
            android:clickable="true"
            android:focusable="true"
            android:background="?android:attr/selectableItemBackground" />

    </LinearLayout>

</ScrollView>
