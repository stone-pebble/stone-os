<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="#000000">

    <!-- World Clock Section (33% height) -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:orientation="horizontal"
        android:gravity="center"
        android:paddingLeft="16dp"
        android:paddingRight="16dp"
        android:background="#000000">

        <!-- San Francisco -->
        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:orientation="vertical"
            android:gravity="center">

            <TextView
                android:id="@+id/time_sf"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="00:00"
                android:textSize="48sp"
                android:textColor="#FFFFFF"
                android:fontFamily="serif"
                android:letterSpacing="0" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/san_francisco"
                android:textSize="14sp"
                android:textColor="#FFFFFF"
                android:fontFamily="serif"
                android:layout_marginTop="8dp" />
        </LinearLayout>

        <!-- New York -->
        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:orientation="vertical"
            android:gravity="center">

            <TextView
                android:id="@+id/time_ny"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="00:00"
                android:textSize="48sp"
                android:textColor="#FFFFFF"
                android:fontFamily="serif"
                android:letterSpacing="0" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/new_york"
                android:textSize="14sp"
                android:textColor="#FFFFFF"
                android:fontFamily="serif"
                android:layout_marginTop="8dp" />
        </LinearLayout>

        <!-- Tokyo -->
        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:orientation="vertical"
            android:gravity="center">

            <TextView
                android:id="@+id/time_tokyo"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="00:00"
                android:textSize="48sp"
                android:textColor="#FFFFFF"
                android:fontFamily="serif"
                android:letterSpacing="0" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/tokyo"
                android:textSize="14sp"
                android:textColor="#FFFFFF"
                android:fontFamily="serif"
                android:layout_marginTop="8dp" />
        </LinearLayout>

    </LinearLayout>

    <!-- Divider -->
    <View
        android:layout_width="match_parent"
        android:layout_height="1dp"
        android:background="#1AFFFFFF" />

    <!-- Bottom Section (67% height) - 3 columns -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="2"
        android:orientation="horizontal"
        android:background="#000000">

        <!-- Alarms Column -->
        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:orientation="vertical"
            android:background="#000000">

            <ScrollView
                android:id="@+id/alarms_scroll"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:scrollbars="none"
                android:padding="16dp">

                <LinearLayout
                    android:id="@+id/alarms_container"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical" />

            </ScrollView>

        </LinearLayout>

        <!-- Vertical Divider -->
        <View
            android:layout_width="1dp"
            android:layout_height="match_parent"
            android:background="#1AFFFFFF" />

        <!-- Stopwatch Column -->
        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:orientation="vertical"
            android:padding="16dp"
            android:background="#000000">

            <TextView
                android:id="@+id/stopwatch_time"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="00:00.00"
                android:textSize="20sp"
                android:textColor="#FFFFFF"
                android:fontFamily="serif"
                android:gravity="center"
                android:layout_marginBottom="16dp" />

            <ScrollView
                android:id="@+id/laps_scroll"
                android:layout_width="match_parent"
                android:layout_height="0dp"
                android:layout_weight="1"
                android:scrollbars="none">

                <LinearLayout
                    android:id="@+id/laps_container"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical" />

            </ScrollView>

            <Button
                android:id="@+id/stopwatch_lap_reset"
                android:layout_width="match_parent"
                android:layout_height="48dp"
                android:text="@string/reset"
                android:textColor="#B3FFFFFF"
                android:fontFamily="serif"
                android:textSize="14sp"
                android:background="@android:drawable/dialog_holo_dark_frame"
                android:textAllCaps="false"
                android:layout_marginBottom="8dp" />

            <Button
                android:id="@+id/stopwatch_start_stop"
                android:layout_width="match_parent"
                android:layout_height="48dp"
                android:text="@string/start"
                android:textColor="#B3FFFFFF"
                android:fontFamily="serif"
                android:textSize="14sp"
                android:background="@android:drawable/dialog_holo_dark_frame"
                android:textAllCaps="false" />

        </LinearLayout>

        <!-- Vertical Divider -->
        <View
            android:layout_width="1dp"
            android:layout_height="match_parent"
            android:background="#1AFFFFFF" />

        <!-- Timer Column -->
        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:orientation="vertical"
            android:padding="16dp"
            android:background="#000000">

            <TextView
                android:id="@+id/timer_display"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="00:00:00"
                android:textSize="20sp"
                android:textColor="#FFFFFF"
                android:fontFamily="serif"
                android:gravity="center"
                android:layout_marginBottom="32dp" />

            <!-- Timer Input Controls -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="0dp"
                android:layout_weight="1"
                android:orientation="vertical"
                android:gravity="center">

                <!-- Hours -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:gravity="center"
                    android:layout_marginBottom="16dp">

                    <Button
                        android:id="@+id/timer_hour_minus"
                        android:layout_width="40dp"
                        android:layout_height="40dp"
                        android:text="-"
                        android:textColor="#B3FFFFFF"
                        android:fontFamily="serif"
                        android:background="@android:drawable/dialog_holo_dark_frame"
                        android:textAllCaps="false" />

                    <TextView
                        android:id="@+id/timer_hours"
                        android:layout_width="60dp"
                        android:layout_height="wrap_content"
                        android:text="00"
                        android:textSize="28sp"
                        android:textColor="#FFFFFF"
                        android:fontFamily="serif"
                        android:gravity="center"
                        android:layout_marginLeft="8dp"
                        android:layout_marginRight="8dp" />

                    <Button
                        android:id="@+id/timer_hour_plus"
                        android:layout_width="40dp"
                        android:layout_height="40dp"
                        android:text="+"
                        android:textColor="#B3FFFFFF"
                        android:fontFamily="serif"
                        android:background="@android:drawable/dialog_holo_dark_frame"
                        android:textAllCaps="false" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="h"
                        android:textSize="14sp"
                        android:textColor="#80FFFFFF"
                        android:fontFamily="serif"
                        android:layout_marginLeft="4dp" />
                </LinearLayout>

                <!-- Minutes -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:gravity="center"
                    android:layout_marginBottom="16dp">

                    <Button
                        android:id="@+id/timer_minute_minus"
                        android:layout_width="40dp"
                        android:layout_height="40dp"
                        android:text="-"
                        android:textColor="#B3FFFFFF"
                        android:fontFamily="serif"
                        android:background="@android:drawable/dialog_holo_dark_frame"
                        android:textAllCaps="false" />

                    <TextView
                        android:id="@+id/timer_minutes"
                        android:layout_width="60dp"
                        android:layout_height="wrap_content"
                        android:text="00"
                        android:textSize="28sp"
                        android:textColor="#FFFFFF"
                        android:fontFamily="serif"
                        android:gravity="center"
                        android:layout_marginLeft="8dp"
                        android:layout_marginRight="8dp" />

                    <Button
                        android:id="@+id/timer_minute_plus"
                        android:layout_width="40dp"
                        android:layout_height="40dp"
                        android:text="+"
                        android:textColor="#B3FFFFFF"
                        android:fontFamily="serif"
                        android:background="@android:drawable/dialog_holo_dark_frame"
                        android:textAllCaps="false" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="m"
                        android:textSize="14sp"
                        android:textColor="#80FFFFFF"
                        android:fontFamily="serif"
                        android:layout_marginLeft="4dp" />
                </LinearLayout>

                <!-- Seconds -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:gravity="center">

                    <Button
                        android:id="@+id/timer_second_minus"
                        android:layout_width="40dp"
                        android:layout_height="40dp"
                        android:text="-"
                        android:textColor="#B3FFFFFF"
                        android:fontFamily="serif"
                        android:background="@android:drawable/dialog_holo_dark_frame"
                        android:textAllCaps="false" />

                    <TextView
                        android:id="@+id/timer_seconds"
                        android:layout_width="60dp"
                        android:layout_height="wrap_content"
                        android:text="00"
                        android:textSize="28sp"
                        android:textColor="#FFFFFF"
                        android:fontFamily="serif"
                        android:gravity="center"
                        android:layout_marginLeft="8dp"
                        android:layout_marginRight="8dp" />

                    <Button
                        android:id="@+id/timer_second_plus"
                        android:layout_width="40dp"
                        android:layout_height="40dp"
                        android:text="+"
                        android:textColor="#B3FFFFFF"
                        android:fontFamily="serif"
                        android:background="@android:drawable/dialog_holo_dark_frame"
                        android:textAllCaps="false" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="s"
                        android:textSize="14sp"
                        android:textColor="#80FFFFFF"
                        android:fontFamily="serif"
                        android:layout_marginLeft="4dp" />
                </LinearLayout>

            </LinearLayout>

            <Button
                android:id="@+id/timer_start_stop"
                android:layout_width="match_parent"
                android:layout_height="48dp"
                android:text="@string/start"
                android:textColor="#B3FFFFFF"
                android:fontFamily="serif"
                android:textSize="14sp"
                android:background="@android:drawable/dialog_holo_dark_frame"
                android:textAllCaps="false"
                android:layout_marginTop="16dp" />

        </LinearLayout>

    </LinearLayout>

</LinearLayout>
