# LiveKit Connection (Required)
LIVEKIT_URL=wss://your-project.livekit.cloud
LIVEKIT_API_KEY=your_api_key_here
LIVEKIT_API_SECRET=your_api_secret_here

# Agent Server Configuration
AGENT_PORT=8081
TOKEN_SERVER_PORT=8000

# AI Provider API Keys (Optional - can use LiveKit Inference Gateway)
# If not provided, agent will use inference gateway pattern
OPENAI_API_KEY=sk-...
ASSEMBLYAI_API_KEY=...
DEEPGRAM_API_KEY=...
ELEVENLABS_API_KEY=...
CARTESIA_API_KEY=...

# Development Settings
NODE_ENV=development
LOG_LEVEL=debug
