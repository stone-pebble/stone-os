{
  "name": "stone-agent-server",
  "version": "0.1.0-alpha",
  "description": "LiveKit agents.js server for StoneOS AI agents",
  "type": "module",
  "main": "dist/index.js",
  "scripts": {
    "build": "tsc",
    "dev": "tsx src/index.ts dev --log-level=debug",
    "dev:token": "tsx src/server/token-server.ts",
    "start": "node dist/index.js start",
    "start:token": "node dist/server/token-server.js",
    "start:production": "node scripts/start-production.js",
    "connect": "tsx src/index.ts connect",
    "token-server": "tsx src/server/token-server.ts",
    "test": "echo \"No tests yet\" && exit 0"
  },
  "dependencies": {
    "@livekit/agents": "^1.0.18",
    "@livekit/agents-plugin-silero": "^1.0.18",
    "cors": "^2.8.5",
    "dotenv": "^16.4.7",
    "express": "^4.21.2",
    "livekit-client": "^2.15.15",
    "livekit-server-sdk": "^2.7.2",
    "zod": "^3.24.1"
  },
  "devDependencies": {
    "@types/cors": "^2.8.17",
    "@types/express": "^5.0.0",
    "@types/node": "^22.15.18",
    "tsx": "^4.19.2",
    "typescript": "^5.7.2"
  },
  "engines": {
    "node": ">=20.0.0"
  }
}
